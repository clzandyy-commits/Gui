-- ─── LIVE STATS ──────────────────────────────────────────────
task.spawn(function()
    -- Gerçek FPS ölçümü: RenderStepped ile frame say, os.clock ile süre böl
    local frameCount = 0
    local measureStart = os.clock()

    RunService.RenderStepped:Connect(function()
        frameCount += 1
    end)

    while gui.Parent do
        task.wait(2)
        if not gui.Parent then break end

        -- FPS: son penceredeki frame sayısı / geçen gerçek süre
        local now     = os.clock()
        local elapsed = now - measureStart
        local fps     = 0
        if elapsed > 0 then
            fps = math.floor(frameCount / elapsed + 0.5)
        end
        frameCount   = 0
        measureStart = now

        if statValues.fps then
            statValues.fps.Text       = tostring(fps)
            statValues.fps.TextColor3 = fps >= 45 and C.OK or fps >= 25 and C.WARN or C.ERR
        end

        -- Ping
        pcall(function()
            local ok, ping = pcall(function()
                local item = Stats.Network.ServerStatsItem["Data Ping"]
                return item and math.floor(item:GetValue()) or 0
            end)
            if statValues.ping then
                statValues.ping.Text = (ok and ping or 0) .. " ms"
            end
        end)

        -- Memory
        pcall(function()
            local mem = math.floor(collectgarbage("count") / 1024)
            if statValues.memory then statValues.memory.Text = mem .. " MB" end
        end)
    end
end)
