-- ─── TABS ────────────────────────────────────────────────────
local tabs      = {}
local activeTab = nil

local function updateIndicator(btn)
    if not btn or not btn.Parent then return end
    RunService.Heartbeat:Wait()
    if not btn.Parent then return end
    local localX = btn.AbsolutePosition.X - tabBar.AbsolutePosition.X
    Tween:Create(indicator, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, localX, 0, 4),
        Size     = UDim2.new(0, btn.AbsoluteSize.X, 1, -8),
    }):Play()
end

local function switchTab(id)
    if activeTab == id then return end
    activeTab = id

    contentArea.Visible = true
    tabBar.Visible      = true

    for tabId, data in pairs(tabs) do
        local isActive = (tabId == id)
        Tween:Create(data.btn, TweenInfo.new(0.2), {
            TextColor3 = isActive and C.TEXT or C.TEXT_DIM,
        }):Play()
        data.content.Visible = isActive

        if isActive then
            data.content.Position = UDim2.new(0, 10, 0, 0)
            Tween:Create(data.content, TweenInfo.new(0.22), {
                Position = UDim2.new(0, 0, 0, 0),
            }):Play()
            task.spawn(updateIndicator, data.btn)
        end
    end
end

