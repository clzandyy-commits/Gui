            BackgroundColor3 = v and C.ACCENT or C.CARD_HI,
        }):Play()
        Tween:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = v and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        }):Play()
    end

    local click = Instance.new("TextButton")
    click.Size                   = UDim2.new(1, 0, 1, 0)
    click.BackgroundTransparency = 1
    click.Text                   = ""
    click.Parent                 = track
    click.MouseButton1Click:Connect(function() setState(not state) end)

    cfg[key] = {
        get = function() return state end,
        set = setState,
    }
end

